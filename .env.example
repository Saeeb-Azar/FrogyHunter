# Firebase Web-App-Konfiguration (Projekteinstellungen → App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Komma-getrennte Firebase-Auth-UIDs für Admin-Zugriff (zusätzlich zu Firestore `admins`)
VITE_ADMIN_UIDS=

# Supabase takes precedence when both values are set. Run the included migration first.
# Public URL + anon/publishable key ONLY. Never put a service_role key in a VITE variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional public contact details (no generated legal text)
VITE_SUPPORT_EMAIL=
VITE_INSTAGRAM_URL=
VITE_IMPRINT_URL=
VITE_PRIVACY_URL=
